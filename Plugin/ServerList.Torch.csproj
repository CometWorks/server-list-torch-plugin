<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>CometWorks.ServerList.Torch</AssemblyName>
    <Version>0.1.0</Version>
    <Game Condition="'$(Game)' == ''">$(Torch)/DedicatedServer64</Game>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <Reference Include="Torch"><HintPath>$(Torch)/Torch.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Torch.API"><HintPath>$(Torch)/Torch.API.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="NLog"><HintPath>$(Torch)/NLog.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Torch)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="protobuf-net"><HintPath>$(Torch)/protobuf-net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(Game)/Sandbox.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sandbox.Common"><HintPath>$(Game)/Sandbox.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage"><HintPath>$(Game)/VRage.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(Game)/VRage.Game.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(Game)/VRage.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(Game)/VRage.Math.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup><None Include="../manifest.xml" Link="manifest.xml" CopyToOutputDirectory="Always" /></ItemGroup>
</Project>
